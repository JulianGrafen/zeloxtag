{
  "name": "zeloxtag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run test:extraction && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:extraction": "vitest run src/lib/ocr/extraction-quality.test.ts src/lib/ocr/prepare-document-for-llm.test.ts src/services/documents/document-services.test.ts",
    "test:abe-fixtures": "vitest run src/lib/ocr/abe-kba-48571-fixture.test.ts src/lib/ocr/abe-wizard-vehicle-normalize.test.ts src/lib/ocr/abe-auflagen-from-text.test.ts src/lib/ocr/auflagen-kuerzel-ocr-correction.test.ts",
    "test:abe-hunt": "tsx scripts/test-abe-hunt-extraction.ts",
    "predeploy": "npm run test:extraction",
    "db:seed-demo": "node --env-file=.env scripts/seed-demo-vehicle.mjs",
    "db:mint-tag": "node --env-file=.env scripts/mint-unclaimed-tag.mjs --qr",
    "db:seed-kuerzel": "npx tsx scripts/seed-abe-auflagen-kuerzel.ts",
    "db:generate-kuerzel-migration": "npx tsx scripts/generate-kuerzel-migration.ts",
    "postinstall": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@react-pdf/renderer": "^4.6.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.109.0",
    "browser-image-compression": "^2.0.2",
    "framer-motion": "^13.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "openai": "^6.49.0",
    "pdfjs-dist": "^5.6.205",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-image-crop": "^11.1.2",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
